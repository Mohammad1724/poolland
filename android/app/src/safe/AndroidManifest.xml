<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The "safe" flavor must install on phones where Google Play Protect is
      enabled.

      Play Protect hard-blocks internet-sideloaded APKs (browser, messaging
      app, file manager) that declare READ_SMS or RECEIVE_SMS, regardless of
      how the APK is signed. This overlay removes both permissions and the
      receiver that used them, so the installer sees a normal ledger app with
      no sensitive permissions.

      The full flavor keeps the declarations from src/main/AndroidManifest.xml
      and is the one that can read the SMS inbox automatically.
    -->
    <uses-permission
        android:name="android.permission.READ_SMS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.RECEIVE_SMS"
        tools:node="remove" />

    <application>
        <receiver
            android:name="com.poolland.app.SmsReceiver"
            tools:node="remove" />
    </application>
</manifest>
